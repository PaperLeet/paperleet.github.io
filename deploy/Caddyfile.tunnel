# HTTPS terminates at Cloudflare; this listener is only inside Docker.
# The tunnel's published application must target http://web:80 and preserve
# the public Host header. No host port may be published for this configuration.
http://{$PAPERLEET_DOMAIN}:80 {
    encode zstd gzip
    header /data/index.json Cache-Control "no-cache"
    header /data/modules/* Cache-Control "public, max-age=31536000, immutable"
    header /browser-runtime/* Access-Control-Allow-Origin "*"
    header /browser-runtime/* Cross-Origin-Resource-Policy "cross-origin"
    header /browser-runtime/* Cache-Control "public, max-age=31536000, immutable"
    header /browser-judge/* Access-Control-Allow-Origin "*"
    header /browser-judge/* Cross-Origin-Resource-Policy "cross-origin"
    header /browser-judge/* Cache-Control "no-cache"
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }
    request_body {
        max_size 256KB
    }
    handle /api/* {
        header Cache-Control no-store
        reverse_proxy api:8765 {
            # Cloudflare supplies this header. Trust it only in this private
            # tunnel configuration; the direct public proxy uses remote_host.
            header_up X-PaperLeet-Client-IP {http.request.header.CF-Connecting-IP}
            transport http {
                response_header_timeout 115s
            }
        }
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

:80 {
    respond "Unknown hostname" 421
}
