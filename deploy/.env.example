# Copy to deploy/.env. Never commit the real file.
PAPERLEET_DOMAIN=paperleet.example.org
# Explicitly choose test to use administrator-created accounts without email.
# Institutional mode remains the default; see docs/test-accounts.md.
PAPERLEET_AUTH_MODE=institutional
# work_email: school/company domains, excluding common personal email services.
# invite_only: exact invited addresses AND reviewed domains (legacy default).
PAPERLEET_REGISTRATION_POLICY=work_email
# Optional additional personal/disposable domains to block, comma-separated.
PAPERLEET_BLOCKED_EMAIL_DOMAINS=
# These email settings may be empty when PAPERLEET_AUTH_MODE=test.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
# Only required in invite_only policy. Unused in work_email and test mode.
PAPERLEET_INVITE_EMAILS=
PAPERLEET_ADMIN_EMAILS=alice@mit.edu
# Replace with output of: openssl rand -hex 32
PAPERLEET_JUDGE_TOKEN=replace-with-a-random-64-character-hex-token
